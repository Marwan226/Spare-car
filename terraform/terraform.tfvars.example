project_name = "graduation-k8s"
environment  = "dev"
aws_region   = "us-east-1"

# Replace with your real public IP, for example ["203.0.113.10/32"].
admin_cidrs = ["YOUR_PUBLIC_IP/32"]

# Optional. Set to an existing AWS EC2 key pair if you want SSH access.
key_name = null

worker_min_size     = 1
worker_desired_size = 2
worker_max_size     = 4

# Optional. Add an ACM certificate ARN in the same region to enable HTTPS.
acm_certificate_arn = null
